// gramide — syntax trees for coding agents: the command line over every
// language package, composed here and nowhere else.
//
// The engine is gramide, and a language is a package of its own —
// gramide_almide, gramide_go, gramide_rust, gramide_python — each with its
// grammar, its compiled table, its tests and its own binary. This file says
// which of them this binary ships. Adding a language is one line in
// `packages()` and one in almide.toml.
import gramide.cli
import gramide.package_api
import gramide_almide
import gramide_go
import gramide_rust
import gramide_python
import env

let VERSION = "0.2.0"

// Every package this binary ships, built by name: a `fan` arm below cannot
// carry a package, because its lexer is a closure.
fn packages() -> List[package_api.Definition] =
  [gramide_almide.definition(), gramide_go.definition(), gramide_rust.definition(), gramide_python.definition()]

// `check` and `balance` over many files: eight byte-balanced slices of the
// file list, checked in parallel and answered in list order. The block stands
// here rather than in gramide because each arm has to build the packages
// by name, which only the binary that composes them can do.
effect fn parallel(cmd: String, paths: List[String]) -> List[cli.Chunk] = {
  let cuts = cli.cut_points(paths, 8)!
  let c0 = cli.cut_at(cuts, 0)
  let c1 = cli.cut_at(cuts, 1)
  let c2 = cli.cut_at(cuts, 2)
  let c3 = cli.cut_at(cuts, 3)
  let c4 = cli.cut_at(cuts, 4)
  let c5 = cli.cut_at(cuts, 5)
  let c6 = cli.cut_at(cuts, 6)
  let c7 = cli.cut_at(cuts, 7)
  let c8 = list.len(paths)
  let r = fan {
    cli.check_chunk(packages(), cmd, paths, c0, c1),
    cli.check_chunk(packages(), cmd, paths, c1, c2),
    cli.check_chunk(packages(), cmd, paths, c2, c3),
    cli.check_chunk(packages(), cmd, paths, c3, c4),
    cli.check_chunk(packages(), cmd, paths, c4, c5),
    cli.check_chunk(packages(), cmd, paths, c5, c6),
    cli.check_chunk(packages(), cmd, paths, c6, c7),
    cli.check_chunk(packages(), cmd, paths, c7, c8)
  }
  [r.0, r.1, r.2, r.3, r.4, r.5, r.6, r.7]
}

effect fn main() -> Unit = {
  let argv = env.args()
  match cli.batch_of(argv) {
    some((cmd, paths)) => cli.report(parallel(cmd, paths)!),
    none => cli.run(cli.Program { name: "gramide", version: VERSION, packages: packages() }, argv),
  }
}
